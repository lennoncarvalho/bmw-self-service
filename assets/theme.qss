/* BMW Self Service — Dark Theme
 *
 * Colors:
 *   Background:    #0a0e17 (dark navy)
 *   Surface:       #101520 (slightly lighter card bg)
 *   Primary:       #1C69D4 (BMW blue)
 *   Primary hover: #0653B6 (BMW dark blue)
 *   Danger:        #E30B1F (BMW red)
 *   Text primary:  #e0e0e0
 *   Text secondary:#a0a0a0
 *   Border:        #262a34
 *   Success:       #2ECC71
 *   Warning:       #F39C12
 *
 * Style: rounded corners (8px), dark palette, high contrast.
 */

/* ── Global ─────────────────────────────────────────────────────────────── */

QMainWindow {
    background-color: #0a0e17;
}

QWidget {
    background-color: #0a0e17;
    color: #e0e0e0;
    font-size: 14px;
}

/* ── Labels ──────────────────────────────────────────────────────────── */

QLabel {
    color: #e0e0e0;
    background: transparent;
    border: none;
}

QLabel#titleLabel {
    font-size: 22px;
    font-weight: bold;
    color: #ffffff;
}

QLabel#subtitleLabel {
    font-size: 16px;
    color: #a0a0a0;
}

QLabel#statusDot {
    font-size: 14px;
    min-width: 20px;
}

/* ── Buttons ─────────────────────────────────────────────────────────── */

QPushButton {
    background-color: #1C69D4;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: bold;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #0653B6;
}

QPushButton:pressed {
    background-color: #0442A0;
}

QPushButton:disabled {
    background-color: #242933;
    color: #888888;
}

QPushButton#connectButton {
    font-size: 18px;
    padding: 16px 48px;
    border-radius: 12px;
    min-height: 48px;
}

QPushButton#dangerButton {
    background-color: #E30B1F;
}

QPushButton#dangerButton:hover {
    background-color: #C40A1A;
}

QPushButton#successButton {
    background-color: #2ECC71;
}

QPushButton#successButton:hover {
    background-color: #27AE60;
}

/* ── Navigation Buttons (Bottom Bar) ──────────────────────────────── */

QPushButton#navButton {
    background-color: transparent;
    color: #a0a0a0;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 11px;
    min-height: 52px;
}

QPushButton#navButton:checked {
    color: #1C69D4;
    background-color: rgba(28, 105, 212, 0.12);
}

QPushButton#navButton:hover:!checked {
    color: #d0d0d0;
}

QPushButton#navButton:disabled {
    color: #555555;
    background-color: transparent;
}

/* ── Scroll Areas ────────────────────────────────────────────────── */

QScrollArea {
    background-color: #0a0e17;
    border: none;
}

QScrollBar:vertical {
    background-color: #0a0e17;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #242933;
    border-radius: 4px;
    min-height: 30 px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4a4a6a;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #0a0e17;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background-color: #242933;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Cards ─────────────────────────────────────────────────────────── */

QFrame#card {
    background-color: #101520;
    border: 1px solid #262a34;
    border-radius: 8px;
    padding: 12px;
}

QFrame#card:hover {
    border-color: #1C69D4;
}

QPushButton#codingSection {
    background: transparent;
    text-align: left;
    padding: 4px 0;
    font-size: 15px;
}

QPushButton#codingSection:hover, QPushButton#codingSection:focus {
    color: #77b5ff;
}

QWidget#codingFeature {
    background: transparent;
}

/* ── Top Bar ──────────────────────────────────────────────────────────── */

QFrame#topBar {
    background-color: #0f0f23;
    border-bottom: 1px solid #262a34;
    min-height: 48px;
    max-height: 48 px;
}

/* ── Bottom Nav Bar ─────────────────────────────────────────────── */

QFrame#bottomNav {
    background-color: #0f0f23;
    border-top: 1px solid #262a34;
    min-height: 68 px;
    max-height: 68px;
}

/* ── Comobox (Series/Interface Pickers) ─────────────────────────── */

QComboBox {
    background-color: #101520;
    color: #e0e0e0;
    border: 1 px solid #262a34;
    border-radius: 8px;
    padding: 8px 12px;
    min-height: 24px;
}

QComboBox:hover {
    border-color: #1C69D4;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #101520;
    color: #e0e0e0;
    border: 1px solid #262a34;
    selection-background-color: #1C69D4;
}

/* ── Mens ──────────────────────────────────────────────────────────── */

QMenu {
    background-color: #101520;
    color: #e0e0e0;
    border: 1px solid #262a34;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #1C69D4;
}

QMenu::separator {
    height: 1px;
    background: #262a34;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    margin-left: 8px;
}

/* ── Tooltips ─────────────────────────────────────────────────────── */

QToolTip {
    background-color: #0f0f23;
    color: #e0e0e0;
    border: 1px solid #262a34;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* ── Spinner Overlay ──────────────────────────────────────────────── */

QFrame#spinnerOverlay {
    background-color: rgba(26, 26, 46, 0.85);
    border-radius: 12px;
}

QLabel#spinnerText {
    color: #e0e0e0;
    font-size: 16px;
    font-weight: bold;
}

/* ── Dialog ────────────────────────────────────────────────────────── */

QDialog {
    background-color: #0a0e17;
}

/* ── Checkox ──────────────────────────────────────────────────────── */

QCheckBox {
    color: #e0e0e0;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #242933;
    border-radius: 4px;
    background-color: #101520;
}

QCheckBox::indicator:checked {
    background-color: #1C69D4;
    border-color: #1C69D4;
}

/* ── Radio Button ──────────────────────────────────────────────────── */

QRadioButton {
    color: #e0e0e0;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #242933;
    border-radius: 9px;
    background-color: #101520;
}

QRadioButton::indicator:checked {
    background-color: #1C69D4;
    border-color: #1C69D4;
}

/* ── Line Edit / Text Input ─────────────────────────────────────────── */

QLineEdit {
    background-color: #101520;
    color: #e0e0e0;
    border: 1px solid #262a34;
    border-radius: 8px;
    padding: 8px 12px;
}

QLineEdit:focus {
    border-color: #1C69D4;
}

/* ── SpinBox ────────────────────────────────────────────────────────── */

QSpinBox {
    background-color: #101520;
    color: #e0e0e0;
    border: 1px solid #262a34;
    border-radius: 8px;
    padding: 8px 12px;
}

QSpinBox::up-button, QSpinBox::down-button {
    border: none;
    background: transparent;
    width: 20px;
}

/* ── DateEdit ────────────────────────────────────────────────────────── */

QDateEdit {
    background-color: #101520;
    color: #e0e0e0;
    border: 1 px solid #262a34;
    border-radius: 8px;
    padding: 8px 12px;
    min-height: 24px;
}
/* Connection overview: color always accompanies an explicit MIL label. */
QLabel#milStatus {
    border-radius: 8px;
    padding: 12px;
    font-size: 14px;
    font-weight: bold;
    background: #242430;
    color: #a0a0a0;
}
QLabel#milStatus[milState="on"] { color: #ff6666; background: #382020; }
QLabel#milStatus[milState="off"] { color: #66cc88; background: #203328; }
QLabel#overviewCaption { color: #a0a0a0; font-size: 12px; }
QLabel#faultDetailHeading { font-size: 12px; font-weight: bold; color: #e0e0e0; }
QLabel#faultDetailValue { font-size: 12px; color: #a0a0a0; }
QLabel#dtcHeading { font-size: 15px; font-weight: bold; color: #1C69D4; }
QLabel#dtcMeta { font-size: 11px; color: #a0a0a0; }
QPushButton#dtcSearchButton {
    background: transparent;
    color: #1C69D4;
    border: 1px solid #1C69D4;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 11px;
}
QPushButton#dtcSearchButton:hover { background: rgba(28,105,212,0.15); }

/* Foreground loading blocks interaction with the underlying pages. */
QFrame#loadingBackdrop {
    background-color: rgba(0, 0, 0, 155);
}

QProgressBar#loadingProgress {
    border: none;
    border-radius: 3px;
    background-color: #262a34;
}
QProgressBar#loadingProgress::chunk {
    border-radius: 3px;
    background-color: #1C69D4;
}

/* Stitch cockpit surfaces and shared presentation roles. */
QWidget {
    font-family: "BMWGroupTN Pro TT", "Helvetica Neue";
}
QMainWindow, QWidget#vehicleOverview, QStackedWidget, QScrollArea#pageScrollArea {
    background: #0a0e17;
}
QFrame#cockpitTopBar, QFrame#cockpitRail {
    background: #090e16;
    border: none;
    border-bottom: 1px solid #1c2029;
}
QFrame[class="cockpitCard"] {
    background: #101520;
    border: 1px solid #1c2230;
    border-radius: 8px;
}
QFrame[class="metricCard"] {
    background: #181d26;
    border: 1px solid #262a34;
    border-radius: 4px;
}
QLabel[role="caption"] { color: #c2c6d5; font-size: 13px; }
QLabel[role="eyebrow"] {
    color: #c2c6d5; font-size: 12px; font-weight: bold;
}
QLabel[role="display"] {
    font-family: "BMWGroupTN Condensed Pro TT";
    font-size: 32px; font-weight: bold; color: #dfe2ef;
}
QLabel[role="metric"] {
    font-family: "BMWGroupTN Condensed Pro TT";
    font-size: 25px; font-weight: bold; color: #dfe2ef;
}
QLabel[role="brand"] { font-size: 16px; font-weight: bold; color: #dfe2ef; }
QLabel[role="identity"] { font-size: 13px; font-weight: bold; color: #dfe2ef; }
QLabel[role="badge"] {
    background: #18283f; border-radius: 10px; padding: 4px 10px;
    color: #adc7ff; font-size: 12px;
}
QToolButton#railButton {
    background: transparent; color: #c2c6d5; border: 1px solid transparent;
    border-radius: 7px; padding: 5px 0px;
}
QToolButton#railButton:checked { background: #1c69d2; border-color: #337ddd; }
QToolButton#railButton:hover { background: #263249; }
QToolButton#railButton:disabled { background: transparent; color: #616979; }
QLabel[role="navLabel"] { font-size: 11px; color: #c2c6d5; }
QPushButton[class="railPlaceholder"] {
    background: transparent; padding: 4px; min-height: 24px; border-radius: 4px;
    color: #8c909e; font-size: 10px;
}
QPushButton[class="iconButton"] {
    background: #1c2029; padding: 3px; min-height: 0px; border-radius: 6px;
}
QWidget#vehicleOverview QPushButton, QPushButton[class="secondary"] {
    border-radius: 4px; padding: 9px 14px; font-size: 13px;
}
QPushButton[class="secondary"], QWidget#vehicleOverview QPushButton[class="secondary"] {
    background: #242933; color: #dfe2ef; border: 1px solid #353943;
}
QWidget#vehicleOverview QPushButton[class="cardAction"] {
    background: transparent; color: #adc7ff; text-align: left;
    padding: 8px 0px; border-radius: 4px;
}
QWidget#vehicleOverview QPushButton:hover { background: #2679e5; }
QWidget#vehicleOverview QPushButton[class="secondary"]:hover { background: #353943; }
QWidget#vehicleOverview QPushButton[class="cardAction"]:hover { background: #1c283e; }
QPushButton:focus { border: 2px solid #adc7ff; }
QToolButton#railButton:focus { border: 2px solid #adc7ff; }
QWidget#vehicleOverview QPushButton:disabled { background: #242933; color: #737c8d; }

QWidget[class="transparent"] { background: transparent; }

/* Connection setup and persistent rail utilities. */
QWidget#connectionPage { background: #0a0e17; }
QLabel[role="connectionTitle"] {
    font-family: "BMWGroupTN Condensed Pro TT";
    font-size: 40px;
    font-weight: bold;
    color: #dfe2ef;
}
QWidget#connectionPage QComboBox {
    background: #0a0e17;
    color: #dfe2ef;
    border: 1px solid #424753;
    border-radius: 4px;
    padding: 12px 36px 12px 14px;
    min-height: 22px;
    font-size: 15px;
}
QWidget#connectionPage QComboBox:hover { border-color: #adc7ff; }
QWidget#connectionPage QComboBox:focus {
    border: 1px solid #adc7ff;
    background: #141d2c;
}
QWidget#connectionPage QComboBox::drop-down {
    width: 30px;
    border-left: 1px solid #262a34;
}
QWidget#connectionPage QComboBox QAbstractItemView {
    background: #181c25;
    color: #dfe2ef;
    border: 1px solid #424753;
    selection-background-color: #1c69d2;
    selection-color: #ffffff;
    outline: 0px;
    padding: 6px;
    font-family: "BMWGroupTN Pro TT";
    font-size: 15px;
}
QWidget#connectionPage QComboBox QAbstractItemView::item {
    min-height: 32px;
    padding: 6px 10px;
}
QPushButton#connectionAction {
    background: #1c69d2;
    color: #ffffff;
    border: 1px solid #337ddd;
    border-radius: 4px;
    padding: 13px 18px;
    min-height: 22px;
    font-size: 15px;
    font-weight: bold;
}
QPushButton#connectionAction:hover { background: #2679e5; }
QPushButton#connectionAction:pressed { background: #1257b7; }
QPushButton#connectionAction:focus { border: 2px solid #adc7ff; }
QPushButton#connectionAction:disabled {
    background: #242933;
    color: #8c909e;
    border-color: #353943;
}
QToolButton[class="languagePlaceholder"] {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0px;
    font-size: 23px;
}
QToolButton[class="railUtility"] {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
}
QToolButton[class="railUtility"]:hover { background: #263249; }
QToolButton[class="railUtility"]:pressed { background: #18283f; }
QToolButton[class="railUtility"]:focus { border: 2px solid #adc7ff; }
QToolButton[class="railUtility"]:disabled { background: transparent; }
QWidget#connectionPage QComboBox::down-arrow {
    image: url(cockpit:chevron-down.svg);
    width: 16px;
    height: 16px;
}

/* Shared content surfaces for diagnostics, service, coding and local records. */
QWidget { background: transparent; }
QMainWindow, QDialog { background: #0a0e17; }
QFrame[class="pageHeader"] {
    background: #181c25;
    border: 1px solid #262a34;
    border-radius: 7px;
}
QLabel[role="pageTitle"] {
    font-family: "BMWGroupTN Condensed Pro TT";
    font-size: 30px;
    font-weight: bold;
    color: #dfe2ef;
}
QLabel[role="sectionTitle"], QLabel[role="serviceValue"] {
    font-family: "BMWGroupTN Condensed Pro TT";
    font-size: 23px;
    font-weight: bold;
    color: #dfe2ef;
}
QLabel[role="serviceValue"] { font-size: 30px; color: #adc7ff; }
QLabel[role="featureTitle"] { font-size: 16px; font-weight: bold; color: #dfe2ef; }
QLabel[role="notice"] { color: #e9c27e; }
QFrame#recordCard {
    background: #181c25;
    border: 1px solid #262a34;
    border-radius: 7px;
    padding: 10px;
}
QFrame#recordCard:hover { border-color: #424753; }
QWidget#codingFeature, QWidget[class="comparison"] {
    background: #101520;
    border-radius: 5px;
}
QPushButton {
    border-radius: 4px;
    padding: 9px 14px;
    background: #1c69d2;
}
QPushButton:hover { background: #2679e5; }
QPushButton:pressed { background: #1257b7; }
QPushButton:disabled { background: #242933; color: #8c909e; }
QPushButton[class="disclosure"], QPushButton#codingSection {
    background: #101520;
    color: #adc7ff;
    text-align: left;
    border: 1px solid #262a34;
    padding: 10px;
    border-radius: 4px;
}
QPushButton#codingSection {
    font-family: "BMWGroupTN Condensed Pro TT";
    font-size: 22px;
}
QPushButton[class="disclosure"]:hover, QPushButton#codingSection:hover {
    background: #263249;
}
QPushButton[class="secondary"] { background: #242933; border: 1px solid #353943; }
QPushButton[class="secondary"]:hover { background: #353943; }
QPushButton[class="dangerOutline"] {
    color: #ffb4ab;
    background: #28191f;
    border: 1px solid #74353e;
}
QPushButton[class="dangerOutline"]:hover { background: #44222b; }
QPushButton[class="dangerOutline"]:disabled { color: #8c909e; border-color: #353943; }
QFrame[tone="danger"] { border-color: #74353e; }
QLineEdit, QPlainTextEdit, QDateEdit, QComboBox {
    background: #0a0e17;
    color: #dfe2ef;
    border: 1px solid #424753;
    border-radius: 4px;
    padding: 10px 12px;
    font-family: "BMWGroupTN Pro TT";
    font-size: 14px;
    selection-background-color: #1c69d2;
}
QLineEdit:focus, QPlainTextEdit:focus, QDateEdit:focus, QComboBox:focus {
    border: 1px solid #adc7ff;
}
QLineEdit:disabled, QComboBox:disabled { color: #8c909e; background: #181c25; }
QComboBox { padding-right: 32px; }
QComboBox::down-arrow { image: url(cockpit:chevron-down.svg); width: 16px; height: 16px; }
QComboBox QAbstractItemView {
    background: #181c25;
    color: #dfe2ef;
    selection-background-color: #1c69d2;
    border: 1px solid #424753;
    font-family: "BMWGroupTN Pro TT";
}
QRadioButton, QCheckBox { color: #c2c6d5; spacing: 9px; padding: 6px 2px; }
QRadioButton::indicator {
    width: 16px; height: 16px; border: 1px solid #8c909e;
    border-radius: 8px; background: #0a0e17;
}
QRadioButton::indicator:checked { background: #1c69d2; border: 3px solid #adc7ff; }
QRadioButton:disabled, QCheckBox:disabled { color: #737c8d; }
QRadioButton:focus, QCheckBox:focus { color: #adc7ff; }
QProgressBar { background: #31353f; border: none; border-radius: 3px; }
QProgressBar::chunk { background: #adc7ff; border-radius: 3px; }
QLabel#dtcHeading { color: #dfe2ef; font-size: 18px; }
QLabel#faultDetailHeading { color: #adc7ff; font-size: 13px; }
QLabel#faultDetailValue, QLabel#dtcMeta { color: #c2c6d5; font-size: 13px; }
QDialog#cockpitDialog QLabel { color: #c2c6d5; }
QFrame[class="dateTile"] { background: #262a34; border-radius: 5px; }
QLabel[state="uncertain"], QLabel[state="mismatch"] {
    background: #44222b; color: #ffb4ab;
}
QLabel[state="verified"] { background: #18352b; color: #9de3bd; }
QLabel[state="cycle-required"], QLabel[state="response-confirmed"] {
    background: #18283f; color: #adc7ff;
}
