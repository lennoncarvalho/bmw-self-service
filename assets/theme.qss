/* BMW Self Service — Dark Theme
 *
 * Colors:
 *   Background:    #0a0e17 (dark navy)
 *   Surface:       #0f131c (slightly lighter card bg)
 *   Primary:       #1c69d2 (BMW blue)
 *   Primary hover: #005bc0 (BMW dark blue)
 *   Danger:        #93000a (BMW red)
 *   Text primary:  #dfe2ef
 *   Text secondary:#c2c6d5
 *   Border:        #262a34
 *   Success:       #10b981
 *   Warning:       #f59e0b
 *
 * Style: precise 4px controls, layered dark surfaces, high contrast.
 */

/* ── Global ─────────────────────────────────────────────────────────────── */

/* ── Labels ──────────────────────────────────────────────────────────── */

QLabel {
    color: #dfe2ef;
    background: transparent;
    border: none;
}

/* ── Scroll Areas ────────────────────────────────────────────────── */

QScrollArea {
    background-color: #0a0e17;
    border: none;
}

QScrollBar:vertical {
    background-color: #0a0e17;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #262a34;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4a4a6a;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #0a0e17;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background-color: #262a34;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Cards ─────────────────────────────────────────────────────────── */

QPushButton#codingSection:hover, QPushButton#codingSection:focus {
    color: #77b5ff;
}

/* ── ComboBox (Series/Interface Pickers) ─────────────────────────── */

QComboBox:hover {
    border-color: #1c69d2;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

/* ── Menus ──────────────────────────────────────────────────────────── */

QMenu::indicator {
    width: 16px;
    height: 16px;
    margin-left: 8px;
}

/* ── Tooltips ─────────────────────────────────────────────────────── */

QToolTip {
    background-color: #181c25;
    color: #dfe2ef;
    border: 1px solid #262a34;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* ── Spinner Overlay ──────────────────────────────────────────────── */

QFrame#spinnerOverlay {
    background-color: #181c25;
    border: 1px solid #424753;
    border-radius: 12px;
}

QLabel#spinnerText {
    color: #dfe2ef;
    font-family: "Space Grotesk";
    font-size: 18px;
    font-weight: bold;
}

/* ── Checkbox ──────────────────────────────────────────────────────── */

QCheckBox { min-height: 22px; }
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #262a34;
    border-radius: 4px;
    background-color: #0f131c;
}

/* ── Radio Button ──────────────────────────────────────────────────── */

QRadioButton {
    color: #dfe2ef;
    spacing: 8px;
}

/* ── SpinBox ────────────────────────────────────────────────────────── */

QSpinBox {
    background-color: #0f131c;
    color: #dfe2ef;
    border: 1px solid #262a34;
    border-radius: 8px;
    padding: 8px 12px;
}

QSpinBox::up-button, QSpinBox::down-button {
    border: none;
    background: transparent;
    width: 20px;
}

/* ── DateEdit ────────────────────────────────────────────────────────── */

QDateEdit {
    min-height: 24px;
}
/* MIL colors accompany a read state in both the overview and fault scan. */
QLabel#milStatus {
    border-radius: 8px;
    padding: 12px;
    font-size: 14px;
    font-weight: bold;
    background: #242430;
    color: #c2c6d5;
}
QLabel#milStatus[role="metric"] { font-size: 22px; }
QLabel#milStatus[milState="on"] { color: #ffb4ab; background: #44222b; }
QLabel#milStatus[milState="off"] { color: #66cc88; background: #203328; }

/* Foreground loading blocks interaction with the underlying pages. */
QFrame#loadingBackdrop {
    background-color: rgba(0, 0, 0, 155);
}

QProgressBar#loadingProgress {
    border: none;
    border-radius: 3px;
    background-color: #262a34;
}
QProgressBar#loadingProgress::chunk {
    border-radius: 3px;
    background-color: #1c69d2;
}

/* Cockpit surfaces and shared presentation roles. */

QWidget#vehicleOverview, QStackedWidget, QScrollArea#pageScrollArea {
    background: #0a0e17;
}
QFrame#cockpitTopBar, QFrame#cockpitRail {
    background: #0a0e17;
    border: none;
    border-bottom: 1px solid #1c2029;
}
QFrame[class="cockpitCard"] {
    background: #0f131c;
    border: 1px solid #1c2029;
    border-radius: 8px;
}
QFrame[class="metricCard"] {
    background: #181c25;
    border: 1px solid #262a34;
    border-radius: 4px;
}
QLabel[role="caption"] { color: #c2c6d5; font-size: 13px; }
QLabel[role="supporting"] { color: #c2c6d5; font-size: 12px; }
QLabel[role="supportingStrong"] { color: #c2c6d5; font-size: 12px; font-weight: 600; }
QFrame[class="reviewItem"] {
    background: #181c25;
    border: 1px solid #424753;
    border-left: 3px solid #adc7ff;
    border-radius: 4px;
}
QLabel[role="selectedValue"] { color: #adc7ff; font-size: 13px; font-weight: 600; }
QLabel[role="cardTitle"] {
    font-family: "Space Grotesk"; font-size: 22px; font-weight: 600; color: #dfe2ef;
}
QLabel[role="display"] {
    font-family: "Space Grotesk";
    font-size: 36px; font-weight: 700; color: #dfe2ef;
}
QLabel[role="metric"] {
    font-family: "JetBrains Mono";
    font-size: 22px; font-weight: 600; color: #dfe2ef;
}
QLabel[role="technical"], QLabel#faultDetailValue {
    font-family: "JetBrains Mono"; font-size: 13px;
}
QLabel[role="technicalDisplay"] {
    font-family: "JetBrains Mono"; font-size: 36px; font-weight: 700; color: #dfe2ef;
}
QLabel[role="brand"] { font-size: 16px; font-weight: bold; color: #dfe2ef; }
QLabel[role="identity"] { font-size: 13px; font-weight: bold; color: #dfe2ef; }
QLabel[role="badge"] {
    background: #18283f; border-radius: 10px; padding: 4px 10px;
    color: #adc7ff; font-family: "JetBrains Mono"; font-size: 11px;
}
QToolButton#railButton {
    background: #0a0e17; color: #c2c6d5; border: 1px solid #424753;
    border-radius: 4px; padding: 5px 0px;
}
QToolButton#railButton:checked { background: #1c69d2; border-color: #337ddd; }
QToolButton#railButton:hover { background: #263249; }
QToolButton#railButton:disabled { background: #0a0e17; color: #616979; }

QPushButton[class="iconButton"] {
    background: #1c2029; padding: 3px; min-height: 0px; border-radius: 4px;
}
QWidget#vehicleOverview QPushButton, QPushButton[class="secondary"] {
    border-radius: 4px; padding: 9px 14px; font-size: 13px;
}
QPushButton[class="secondary"], QWidget#vehicleOverview QPushButton[class="secondary"] {
    background: #262a34; color: #dfe2ef; border: 1px solid #353943;
}
QWidget#vehicleOverview QPushButton[class="cardAction"] {
    background: #262a34; color: #adc7ff; text-align: left;
    padding: 9px 14px; border-radius: 4px;
}
QWidget#vehicleOverview QPushButton:hover { background: #186eba; }
QWidget#vehicleOverview QPushButton[class="secondary"]:hover { background: #353943; }
QWidget#vehicleOverview QPushButton[class="cardAction"]:hover { background: #1c283e; }
QPushButton:focus { border: 1px solid #adc7ff; }
QToolButton#railButton:focus { border: 1px solid #adc7ff; }
QWidget#vehicleOverview QPushButton:disabled { background: #262a34; color: #737c8d; }

QWidget[class="transparent"] { background: transparent; }

/* Connection setup and persistent rail utilities. */
QWidget#connectionPage { background: #0a0e17; }
QLabel[role="connectionTitle"] {
    font-family: "Space Grotesk";
    font-size: 36px;
    font-weight: bold;
    color: #dfe2ef;
}
QPushButton#connectionAction {
    background: #1c69d2;
    color: #ffffff;
    border: 1px solid #337ddd;
    border-radius: 4px;
    padding: 9px 14px;
    min-height: 20px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#connectionAction:hover { background: #186eba; }
QPushButton#connectionAction:pressed { background: #005bc0; }
QPushButton#connectionAction:focus { border: 1px solid #adc7ff; }
QPushButton#connectionAction:disabled {
    background: #262a34;
    color: #8c909e;
    border-color: #353943;
}
QToolButton[class="languagePlaceholder"] {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0px;
    font-size: 23px;
}
QToolButton[class="railUtility"] {
    background: #0a0e17;
    border: 1px solid #424753;
    border-radius: 4px;
    padding: 4px;
}
QToolButton[class="railUtility"]:hover { background: #263249; }
QToolButton[class="railUtility"]:pressed { background: #18283f; }
QToolButton[class="railUtility"]:focus { border: 1px solid #adc7ff; }
QToolButton[class="railUtility"]:disabled { background: #0a0e17; }

/* Shared content surfaces for diagnostics, service, coding and local records. */
QWidget {
    color: #dfe2ef;
    font-size: 13px;
    font-family: "Geist", "Helvetica Neue";
    background: transparent;
}
QMainWindow, QDialog { background: #0a0e17; }
/* Popup surfaces must remain opaque after the shared transparent-widget rule. */
QMenu {
    background: #181c25;
    color: #dfe2ef;
    border: 1px solid #424753;
    border-radius: 4px;
    padding: 5px;
    font-family: "Geist";
}
QMenu::item { padding: 8px 28px; border-radius: 3px; }
QMenu::item:selected { background: #263a54; color: #ffffff; }
QMenu::item:disabled { color: #8c909e; }
QMenu::separator { height: 1px; background: #424753; margin: 5px 8px; }
QFrame[class="pageHeader"] {
    background: #181c25;
    border: 1px solid #262a34;
    border-radius: 7px;
}
QLabel[role="pageTitle"] {
    font-family: "Space Grotesk";
    font-size: 28px;
    font-weight: 600;
    color: #dfe2ef;
}
QLabel[role="sectionTitle"] {
    font-family: "Space Grotesk";
    font-size: 23px;
    font-weight: bold;
    color: #dfe2ef;
}

QLabel[role="featureTitle"] {
    font-family: "Space Grotesk"; font-size: 18px; font-weight: 500; color: #dfe2ef;
}
QLabel[role="notice"] { color: #f59e0b; }
QFrame#recordCard {
    background: #181c25;
    border: 1px solid #262a34;
    border-radius: 7px;
    padding: 10px;
}
QFrame#recordCard:hover { border-color: #424753; }
QWidget#codingFeature, QWidget[class="comparison"] {
    background: #0f131c;
    border-radius: 5px;
}
QPushButton {
    min-height: 20px;
    border-radius: 4px;
    padding: 9px 14px;
    background: #1c69d2;
    color: #eaeeff;
    border: 1px solid #424753;
    font-size: 13px;
    font-weight: 600;
}
QPushButton:hover { background: #186eba; }
QPushButton:pressed { background: #005bc0; }
QPushButton:disabled { background: #262a34; color: #8c909e; }
QPushButton[class="disclosure"] {
    background: #0f131c;
    color: #adc7ff;
    text-align: left;
    border: 1px solid #262a34;
    padding: 10px;
    border-radius: 4px;
}
QPushButton#codingSection {
    background: #0f131c;
    color: #adc7ff;
    text-align: left;
    border: 1px solid #262a34;
    padding: 10px;
    border-radius: 4px;
    font-family: "Space Grotesk";
    font-size: 22px;
}
QPushButton[class="disclosure"]:hover, QPushButton#codingSection:hover {
    background: #263249;
}
QPushButton[class="secondary"] { background: #262a34; border: 1px solid #353943; }
QPushButton[class="secondary"]:hover { background: #353943; }
QPushButton[class="dangerOutline"] {
    color: #ffb4ab;
    background: #28191f;
    border: 1px solid #ef4444;
}
QPushButton[class="dangerOutline"]:hover { background: #44222b; }
QPushButton[class="dangerOutline"]:pressed { background: #5f2932; }
QPushButton[class="dangerOutline"]:disabled {
    background: #34232a; color: #9e8287; border-color: #5d3b43;
}
QFrame[tone="danger"] { border-color: #74353e; }
QLineEdit, QPlainTextEdit, QDateEdit {
    background: #0a0e17;
    color: #dfe2ef;
    border: 1px solid #424753;
    border-radius: 4px;
    padding: 10px 12px;
    font-family: "Geist";
    font-size: 14px;
    selection-background-color: #1c69d2;
}
QLineEdit:focus, QPlainTextEdit:focus, QDateEdit:focus, QComboBox:focus {
    border: 1px solid #adc7ff;
}
QLineEdit:disabled, QComboBox:disabled { color: #8c909e; background: #181c25; }
QPlainTextEdit { font-family: "JetBrains Mono"; font-size: 13px; }

QComboBox::down-arrow { image: url(cockpit:chevron-down.svg); width: 16px; height: 16px; }
QComboBox QAbstractItemView {
    background: #181c25;
    color: #dfe2ef;
    selection-background-color: #1c69d2;
    border: 1px solid #424753;
    font-family: "Geist";
}
QRadioButton, QCheckBox { color: #c2c6d5; spacing: 9px; padding: 6px 2px; }
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #8c909e;
    border-radius: 8px;
    background: #0a0e17;
}
QRadioButton::indicator:checked {
    background: #1c69d2;
    border: 3px solid #adc7ff;
}
QRadioButton:disabled, QCheckBox:disabled { color: #737c8d; }
QRadioButton:focus, QCheckBox:focus { color: #adc7ff; }
QRadioButton::indicator:focus, QCheckBox::indicator:focus { border-color: #adc7ff; }
QCheckBox::indicator:checked {
    background: #1c69d2;
    border-color: #1c69d2;
    image: url(cockpit:check.svg);
}
QCheckBox QLabel:disabled { color: #8c909e; }
QProgressBar { background: #31353f; border: none; border-radius: 3px; }
QProgressBar::chunk { background: #adc7ff; border-radius: 3px; }
QLabel#faultDetailHeading { font-weight: bold; color: #adc7ff; font-size: 13px; }
QLabel#faultDetailValue, QLabel#dtcMeta { color: #c2c6d5; font-size: 13px; }
QDialog#cockpitDialog QLabel { color: #c2c6d5; }
QDialog#cockpitDialog QLabel[role="notice"] { color: #f59e0b; }
QDialogButtonBox { button-layout: 1; }
QDialog#cockpitDialog QLabel[role="dialogTitle"] {
    font-family: "Space Grotesk";
    font-size: 28px;
    font-weight: 600;
    color: #dfe2ef;
}
QScrollArea#dialogScroll, QWidget#dialogContent {
    background: #0a0e17;
    border: none;
}
QDialog#cockpitDialog[tone="warning"] QLabel[role="dialogTitle"] {
    color: #f59e0b;
}
QPushButton[class="secondary"]:disabled {
    background: #262a34; color: #737c8d; border-color: #353943;
}

QLabel[state="uncertain"], QLabel[state="mismatch"] {
    background: #44222b; color: #ffb4ab;
}
QLabel[state="verified"] { background: #18352b; color: #9de3bd; }
QLabel[state="cycle-required"], QLabel[state="response-confirmed"] {
    background: #18283f; color: #adc7ff;
}

/* Service history: a compact logbook with explicit vehicle-write states. */
QFrame#historyEntriesTable, QWidget#historyItemTable {
    background: #0f131c;
    border: 1px solid #424753;
    border-radius: 5px;
}
QFrame#historyTableHeader {
    background: #202c40;
    border-bottom: 1px solid #424753;
}
QFrame#recordCard[class="historyEntry"] {
    background: #141b27;
    border: none;
    border-bottom: 1px solid #353943;
    border-left: 3px solid #d5aa62;
    border-radius: 0;
    padding: 0;
}
QFrame#recordCard[class="historyEntry"][writeState="pending"] { background: #241f18; }
QFrame#recordCard[class="historyEntry"][writeState="accepted"] {
    background: #142333; border-left-color: #80b5ed;
}
QFrame#recordCard[class="historyEntry"][writeState="uncertain"],
QFrame#recordCard[class="historyEntry"][writeState="rejected"],
QFrame#recordCard[class="historyEntry"][writeState="conflict"] {
    background: #2b1b23; border-left-color: #f19a99;
}
QLabel[role="historyWriteState"] {
    color: #f59e0b; background: #403320; padding: 4px 8px; border-radius: 3px;
    font-family: "JetBrains Mono"; font-size: 11px;
}
QLabel[role="historyWriteState"][writeState="accepted"] {
    color: #adc7ff; background: #263a54;
}
QLabel[role="historyWriteState"][writeState="uncertain"],
QLabel[role="historyWriteState"][writeState="rejected"],
QLabel[role="historyWriteState"][writeState="conflict"] {
    color: #ffb4ab; background: #44222b;
}
QLabel[role="historyMetadata"] { color: #a0a8b9; font-size: 12px; }
QLabel#historyEntryTitle { font-weight: 600; }
QLabel[role="tableHeader"] {
    font-family: "Geist"; font-size: 13px; font-weight: 600; color: #dfe2ef;
}
QHeaderView::section {
    background: #1c2029; color: #dfe2ef;
    font-family: "Geist"; font-size: 13px; font-weight: 600;
    border: 1px solid #424753; padding: 8px;
}
QLabel#historyEmpty { padding: 24px 16px; }
QPushButton[class="historyAction"] { background: #262a34; color: #c2c6d5; }
QPushButton[class="historyAction"]:hover { background: #353943; }
QPushButton[class="historyAction"]:disabled { color: #737c8d; }
/* Shared Qt form controls, including every surface of their popups. */
/* Qt maps combobox-popup to SH_ComboBox_Popup: use its standard list mode.
 * Set height with min-height, not vertical padding. Qt reads popup margins
 * during construction, before per-instance properties and parents are assigned.
 */
QComboBox {
    background: #0a0e17;
    color: #dfe2ef;
    border: 1px solid #424753;
    border-radius: 4px;
    font-family: "Geist";
    font-size: 14px;
    selection-background-color: #1c69d2;
    combobox-popup: 0;
    padding: 0px 36px 0px 12px;
    min-height: 42px;
}
QDateEdit[formInput="true"] { padding-right: 36px; min-height: 22px; }
QComboBox[formInput="true"][compact="true"] {
    padding: 0px 32px 0px 8px;
    min-height: 32px;
}
QComboBox[formInput="true"]::drop-down, QDateEdit[formInput="true"]::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left: 1px solid #353943;
}
QDateEdit[formInput="true"]::down-arrow {
    image: url(cockpit:calendar.svg);
    width: 16px;
    height: 16px;
}
QDateEdit[formInput="true"] QLineEdit {
    background: transparent;
    border: none;
    padding: 0;
}
QListView#formSelectPopup {
    background: #181c25;
    color: #dfe2ef;
    border: 1px solid #424753;
    padding: 4px;
    outline: none;
    selection-background-color: #263a54;
    selection-color: #ffffff;
}
QWidget#formSelectViewport { background: #181c25; }
QListView#formSelectPopup::item { min-height: 24px; padding: 6px 10px; }
QListView#formSelectPopup::item:hover { background: #202c40; }
QListView#formSelectPopup::item:selected { background: #263a54; color: #ffffff; }
QListView#formSelectPopup::item:disabled { color: #8c909e; }
QCalendarWidget#formCalendar {
    background: #181c25;
    color: #dfe2ef;
    border: 1px solid #424753;
    border-radius: 4px;
}
QCalendarWidget#formCalendar QWidget#qt_calendar_navigationbar {
    background: #202c40;
    border-bottom: 1px solid #424753;
}
QCalendarWidget#formCalendar QAbstractItemView,
QCalendarWidget#formCalendar QAbstractItemView QWidget {
    background: #181c25;
    alternate-background-color: #202c40;
    color: #dfe2ef;
    border: none;
    outline: none;
    selection-background-color: #1c69d2;
    selection-color: #ffffff;
}
QCalendarWidget#formCalendar QToolButton {
    background: transparent;
    color: #dfe2ef;
    border: none;
    border-radius: 3px;
    padding: 6px;
    min-height: 24px;
}
QCalendarWidget#formCalendar QToolButton:hover { background: #263a54; }
QCalendarWidget#formCalendar QToolButton:disabled { color: #737c8d; }
QCalendarWidget#formCalendar QToolButton#qt_calendar_prevmonth {
    qproperty-icon: url(cockpit:chevron-left.svg);
}
QCalendarWidget#formCalendar QToolButton#qt_calendar_nextmonth {
    qproperty-icon: url(cockpit:chevron-right.svg);
}
QCalendarWidget#formCalendar QToolButton::menu-indicator {
    image: url(cockpit:chevron-down.svg); width: 12px; height: 12px;
}
QCalendarWidget#formCalendar QSpinBox {
    background: #0f131c;
    color: #dfe2ef;
    border: 1px solid #adc7ff;
    padding: 2px;
}
QCalendarWidget#formCalendar QLineEdit { background: transparent; border: none; padding: 0; }
QPushButton[class="secondary"]:focus, QPushButton[class="dangerOutline"]:focus {
    border-color: #adc7ff;
}
